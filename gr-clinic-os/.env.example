# Copie este arquivo para `.env.local` (nunca commitado — já está no
# .gitignore) e preencha com os valores do seu projeto Supabase.
# Veja /supabase/README.md para o passo a passo completo de como criar
# o projeto e onde encontrar essas duas chaves.

# Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Settings → API → Project API keys → anon public
# Esta chave é segura para expor no navegador — o RLS do banco é quem
# decide o que cada pessoa pode ver e editar, não o segredo da chave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sem as duas variáveis acima, o app roda no modo demonstração (seletor
# de perfil + dados de exemplo) — nada quebra, mas nada persiste.
