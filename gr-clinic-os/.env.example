# Copie este arquivo para `.env.local` (nunca commitado — já está no
# .gitignore) e preencha com os valores do seu projeto Supabase.
# Veja /supabase/README.md para o passo a passo completo de como criar
# o projeto e onde encontrar essas duas chaves.

# Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Settings → API → Project API keys → anon public
# Esta chave é segura para expor no navegador — o RLS do banco é quem
# decide o que cada pessoa pode ver e editar, não o segredo da chave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sem as duas variáveis acima, o app roda no modo demonstração (seletor
# de perfil + dados de exemplo) — nada quebra, mas nada persiste.

# Settings → API Keys → "Chaves secretas" (secret keys) → padrão
# NUNCA exponha esta chave no navegador nem no código versionado — ela
# ignora todas as regras de permissão do banco. É usada só no servidor,
# só para uma coisa: convidar uma nova pessoa por e-mail (tela Usuários
# e Permissões, só a Administradora vê). Sem ela, a tela de convite
# mostra um aviso claro em vez de travar.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: a URL pública do seu site em produção (ex.: o link do
# Vercel), usada para montar o link de convite por e-mail corretamente.
# Se você publicar no Vercel, pode deixar em branco — ele já detecta
# sozinho. Só preencha se usar outro serviço de hospedagem.
NEXT_PUBLIC_SITE_URL=
